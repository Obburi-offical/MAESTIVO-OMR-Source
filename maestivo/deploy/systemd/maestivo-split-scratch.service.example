# UNINSTALLED candidate; the root-owned release path is a placeholder.
# A mount-creating service must remain in the host mount namespace. Review
# the script and operator/runbook before enabling or changing this unit.
[Unit]
Description=MAESTIVO split worker ephemeral encrypted scratch
After=local-fs.target
RequiresMountsFor=/var/lib
Before=maestivo-split-omr-guard.service maestivo-split-omr.service

[Service]
Type=oneshot
RemainAfterExit=yes
User=root
Group=root
UMask=0077
Environment=PATH=/usr/sbin:/usr/bin:/sbin:/bin
StateDirectory=maestivo-split-scratch-store maestivo-omr-scratch
StateDirectoryMode=0700
RuntimeDirectory=maestivo-split-scratch
RuntimeDirectoryMode=0700
RuntimeDirectoryPreserve=yes
ExecStart=/bin/bash /srv/maestivo/releases/REVIEWED/maestivo-split-scratch.sh start
ExecStop=/bin/bash /srv/maestivo/releases/REVIEWED/maestivo-split-scratch.sh stop
TimeoutStartSec=120s
TimeoutStopSec=120s
Restart=no
NoNewPrivileges=yes
RestrictAddressFamilies=AF_UNIX
LimitCORE=0
MemoryMax=96M
TasksMax=32

[Install]
WantedBy=multi-user.target
